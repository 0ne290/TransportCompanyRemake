           newAdrQualificationFlag = null;
       
       if (driverUpdateRequests.has(driverGuid)) {
           let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
           driverUpdateRequest.SetAdrQualificationFlag = newAdrQualificationFlag;
       }
       else
           driverUpdateRequests.set(driverGuid, { Guid: driverGuid, SetAdrQualificationFlag: newAdrQualificationFlag });
       
       select.classList.replace('inactive', 'active')
   }
   
   function setDriverIsAvailable(select) {
       let driverGuid = select.dataset.driverGuid;
       let newIsAvailable = select.options[select.selectedIndex].value === "true";
       
       if (driverUpdateRequests.has(driverGuid)) {
           let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
