   }
   
   function dismissOrReinstateDriver(button) {
       let driverGuid = button.dataset.driverGuid;
       let dismissOrReinstate = button.value;
       let newPressed = button.dataset.pressed === "false";
       
       if (driverUpdateRequests.has(driverGuid)) {
           let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
           driverUpdateRequest[dismissOrReinstate] = newPressed;
       }
       else
           driverUpdateRequests.set(driverGuid, { Guid: driverGuid, [dismissOrReinstate]: newPressed });
       
       if (newPressed)
           button.classList.replace('inactive', 'active')
       else
           button.classList.replace('active', 'inactive')
           
       button.dataset.pressed = newPressed.toString();
   }
   
