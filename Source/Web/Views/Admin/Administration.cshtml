@using System.Text

@model ICollection<Web.Dtos.Branch>

@{
    ViewBag.Title = "Administrtion";
    Layout = "_FullPageLayout";
    
    var branches = new StringBuilder(400 * Model.Count);
    var selectOfBranches = new StringBuilder(150 * Model.Count);
    @foreach (var branch in Model)
    {
        branches.Append($"<tr><th scope=\"row\"><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Address}\" oninput=\"setBranchAddress(this)\" size=\"47\"></th><td><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Latitude}\" oninput=\"setBranchLatitude(this)\"></td><td><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Longitude}\" oninput=\"setBranchLongitude(this)\"></td><td><button data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"button\" onclick=\"deleteBranch(this)\"><i class=\"fa-solid fa-minus second-text-color\"></i></button></td></tr>");
        selectOfBranches.Append($"<option value=\"{branch.Guid}\">{branch.Address}</option>");
    }
    selectOfBranches.Append("</select>");
    var stringSelectOfBranches = selectOfBranches.ToString();
    
    var drivers = new StringBuilder(1);
    var trucks = new StringBuilder(1);
    @foreach (var branch in Model)
    {
        drivers.Capacity += 1600 * branch.Drivers.Count;
        @foreach (var driver in branch.Drivers)
            drivers.Append($"<tr><th scope=\"row\"><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" value=\"{driver.Name}\" oninput=\"setDriverName(this)\"></th><th scope=\"row\">{$"<select data-driver-guid=\"{driver.Guid}\" class=\"form-select inactive\" onchange=\"setDriverBranch(this)\" style=\"width: 47ch\">" + stringSelectOfBranches.Replace($"<option value=\"{branch.Guid}\">{branch.Address}</option>", $"<option selected value=\"{branch.Guid}\">{branch.Address}</option>")}</th><td>{driver.HireDate}</td><td>{driver.DismissalDate}</td><th scope=\"row\">{$"<select data-driver-guid=\"{driver.Guid}\" class=\"form-select inactive\" onchange=\"setDriverAdrQualificationFlag(this)\"><option value=\"null\">Нет</option><option value=\"Base\">Базовая</option><option value=\"BaseAnd7\">Базовая + класс 7</option><option value=\"BaseAnd1\">Базовая + класс 1</option><option value=\"Full\">Полная</option></select>".Replace($"option value=\"{driver.AdrQualificationFlag}\"", $"option selected value=\"{driver.AdrQualificationFlag}\"")}</th><td>{$"<select data-driver-guid=\"{driver.Guid}\" class=\"form-select inactive\" onchange=\"setDriverIsAvailable(this)\"><option value=\"true\">Да</option><option value=\"false\">Нет</option></select>".Replace($"option value=\"{driver.IsAvailable}\"", $"option selected value=\"{driver.IsAvailable}\"")}</td><td>{$"<select data-driver-guid=\"{driver.Guid}\" class=\"form-select inactive\" onchange=\"setDriverAdrQualificationOfTank(this)\"><option value=\"true\">Да</option><option value=\"false\">Нет</option></select>".Replace($"option value=\"{driver.AdrQualificationOfTank}\"", $"option selected value=\"{driver.AdrQualificationOfTank}\"")}</td><td>{driver.HoursWorkedPerWeek}</td><td>{driver.TotalHoursWorked}</td><td><button data-pressed=\"false\" data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"button\" value=\"{driver.ButtonValue}\" onclick=\"dismissOrReinstateDriver(this)\">{driver.ButtonText}</button></td><td><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" size=\"27\" placeholder=\"Добавить отработанных часов\" oninput=\"addDriverHoursWorked(this)\"></td><td><button data-pressed=\"false\" data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"button\" value=\"ResetHoursWorkedPerWeek\" onclick=\"resetDriverHoursWorkedPerWeek(this)\">Сбросить часы, отработанные за неделю</button></td><td><button data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"button\" onclick=\"deleteDriver(this)\"><i class=\"fa-solid fa-minus second-text-color\"></i></button></td></tr>");
		
        trucks.Capacity += 1600 * branch.Trucks.Count;
        @foreach (var truck in branch.Trucks)
            trucks.Append($"<tr><th scope=\"row\"><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.Number}\" oninput=\"setTruckNumber(this)\"></th><th scope=\"row\">{$"<select data-truck-guid=\"{truck.Guid}\" class=\"form-select inactive\" onchange=\"setTruckBranch(this)\" style=\"width: 47ch\">" + stringSelectOfBranches.Replace($"<option value=\"{branch.Guid}\">{branch.Address}</option>", $"<option selected value=\"{branch.Guid}\">{branch.Address}</option>")}</th><td>{truck.CommissionedDate}</td><td>{truck.DecommissionedDate}</td><th scope=\"row\"><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.PermittedHazardClassesFlags}\" oninput=\"setTruckPermittedHazardClassesFlags(this)\"></th><td>{$"<select data-truck-guid=\"{truck.Guid}\" class=\"form-select inactive\" onchange=\"setTruckIsAvailable(this)\"><option value=\"true\">Да</option><option value=\"false\">Нет</option></select>".Replace($"option value=\"{truck.IsAvailable}\"", $"option selected value=\"{truck.IsAvailable}\"")}</td><td>{$"<select data-truck-guid=\"{truck.Guid}\" class=\"form-select inactive\" onchange=\"setTruckTrailerIsTank(this)\"><option value=\"true\">Цистерна</option><option value=\"false\">Тент</option></select>".Replace($"option value=\"{truck.TrailerIsTank}\"", $"option selected value=\"{truck.TrailerIsTank}\"")}</td><th scope=\"row\"><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.VolumeMax}\" oninput=\"setTruckVolumeMax(this)\"></th><td><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.VolumePrice}\" oninput=\"setTruckVolumePrice(this)\"></td><td><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.WeightMax}\" oninput=\"setTruckWeightMax(this)\"></td><th scope=\"row\"><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.WeightPrice}\" oninput=\"setTruckWeightPrice(this)\"></th><td><input data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"text\" value=\"{truck.PricePerKm}\" oninput=\"setTruckPricePerKm(this)\"></td><td><button data-pressed=\"false\" data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"button\" value=\"{truck.ButtonValue}\" onclick=\"decommissionOrRecommissionTruck(this)\">{truck.ButtonText}</button></td><td><button data-truck-guid=\"{truck.Guid}\" class=\"inactive\" type=\"button\" onclick=\"deleteTruck(this)\"><i class=\"fa-solid fa-minus second-text-color\"></i></button></td></tr>");
    }
}

@section Scripts
{
    <script>
    let branchUpdateRequests = new Map();
    let driverUpdateRequests = new Map();
    let truckUpdateRequests = new Map();
    let guidsOfBranchesToBeDeleted = new Set();
    let guidsOfDriversToBeDeleted = new Set();
    let guidsOfTrucksToBeDeleted = new Set();
    let branchTable = document.getElementById('branch-table');
    let driverTable = document.getElementById('driver-table');
    let truckTable = document.getElementById('truck-table');
    
    function isNullOrWhiteSpace(str) {
        return str === null || str.match(/^ *$/) !== null;
    }
    
    function isNotNumber(str) {
        return isNullOrWhiteSpace(str) || !isFinite(str);
    }
    
    function setBranchAddress(input) {
        let branchGuid = input.dataset.branchGuid;
        let newAddress = input.value;
        
        if (branchUpdateRequests.has(branchGuid)) {
            let branchUpdateRequest = branchUpdateRequests.get(branchGuid);
            branchUpdateRequest.SetAddress = newAddress;
        }
        else
            branchUpdateRequests.set(branchGuid, { Guid: branchGuid, SetAddress: newAddress });
        
        input.classList.replace('inactive', 'active')
    }
    
    function setBranchLatitude(input) {
        let branchGuid = input.dataset.branchGuid;
        let newLatitude = Number(input.value);
        
        if (branchUpdateRequests.has(branchGuid)) {
            let branchUpdateRequest = branchUpdateRequests.get(branchGuid);
            branchUpdateRequest.SetLatitude = newLatitude;
        }
        else
            branchUpdateRequests.set(branchGuid, { Guid: branchGuid, SetLatitude: newLatitude });
        
