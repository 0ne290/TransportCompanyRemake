           truckUpdateRequests.set(truckGuid, { Guid: truckGuid, SetPricePerKm: newPricePerKm });
       
       input.classList.replace('inactive', 'active')
   }
   
   function decommissionOrRecommissionTruck(button) {
       let truckGuid = button.dataset.truckGuid;
       let decommissionOrRecommission = button.value;
       let newPressed = button.dataset.pressed === "false";
       
       if (truckUpdateRequests.has(truckGuid)) {
           let truckUpdateRequest = truckUpdateRequests.get(truckGuid);
           truckUpdateRequest[decommissionOrRecommission] = newPressed;
       }
       else
           truckUpdateRequests.set(truckGuid, { Guid: truckGuid, [decommissionOrRecommission]: newPressed });
       
       if (newPressed)
           button.classList.replace('inactive', 'active')
       else
           button.classList.replace('active', 'inactive')
           
       button.dataset.pressed = newPressed.toString();
   }
   
   function deleteBranch(button) {
       let branchGuid = button.dataset.branchGuid;
       
       if (guidsOfBranchesToBeDeleted.has(branchGuid)) {
           guidsOfBranchesToBeDeleted.delete(branchGuid);
           button.classList.replace('active', 'inactive')
       }
       else {
           guidsOfBranchesToBeDeleted.add(branchGuid);
           button.classList.replace('inactive', 'active');
       }
   }
   
   function deleteDriver(button) {
       let driverGuid = button.dataset.driverGuid;
       
       if (guidsOfDriversToBeDeleted.has(driverGuid)) {
           guidsOfDriversToBeDeleted.delete(driverGuid);
           button.classList.replace('active', 'inactive')
       }
       else {
