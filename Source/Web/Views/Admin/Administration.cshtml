    }
    
    function setDriverBranch(select) {
       let driverGuid = select.dataset.driverGuid;
       let newBranch = select.options[select.selectedIndex].value;
       
       if (driverUpdateRequests.has(driverGuid)) {
           let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
           driverUpdateRequest.SetBranch = newBranch;
       }
