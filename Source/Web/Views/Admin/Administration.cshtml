       }
       else
           truckUpdateRequests.set(truckGuid, { Guid: truckGuid, SetTrailerIsTank: newTrailerIsTank });
       
       select.classList.replace('inactive', 'active')
   }
   
   function setTruckVolumeMax(input) {
       let truckGuid = input.dataset.truckGuid;
       let newVolumeMax = Number(input.value);
       
       if (truckUpdateRequests.has(truckGuid)) {
           let truckUpdateRequest = truckUpdateRequests.get(truckGuid);
           truckUpdateRequest.SetVolumeMax = newVolumeMax;
       }
       else
           truckUpdateRequests.set(truckGuid, { Guid: truckGuid, SetVolumeMax: newVolumeMax });
       
       input.classList.replace('inactive', 'active')
   }
   
   function setTruckVolumePrice(input) {
       let truckGuid = input.dataset.truckGuid;
       let newVolumePrice = Number(input.value);
       
       if (truckUpdateRequests.has(truckGuid)) {
           let truckUpdateRequest = truckUpdateRequests.get(truckGuid);
           truckUpdateRequest.SetVolumePrice = newVolumePrice;
       }
       else
