       let truckGuid = button.dataset.truckGuid;
       
       if (guidsOfTrucksToBeDeleted.has(truckGuid)) {
           guidsOfTrucksToBeDeleted.delete(truckGuid);
           button.classList.replace('active', 'inactive')
       }
       else {
