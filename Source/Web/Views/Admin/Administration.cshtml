           button.classList.replace('inactive', 'active');
       }
   }
   
   function createBranch() {
       branchTable.insertAdjacentHTML('afterbegin', '<tr class="new-branch active"><th scope="row"><input data-field-type="string" data-field-name="Address" class="new-branch-field active" type="text" size="47"></th><td><input data-field-type="number" data-field-name="Latitude" class="new-branch-field active" type="text"></td><td><input data-field-type="number" data-field-name="Longitude" class="new-branch-field active" type="text"></td></tr>');
   }
   
   function createDriver() {
       driverTable.insertAdjacentHTML('afterbegin', '<tr class="new-driver active"><th scope="row"><input data-field-type="string" data-field-name="Name" class="new-driver-field active" type="text"></th><th scope="row">@Html.Raw("<select data-field-type=\"string\" data-field-name=\"BranchGuid\" class=\"new-driver-field form-select active\" style=\"width: 47ch\">" + stringSelectOfBranches)</th><td></td><td></td><th scope="row"><select data-field-type="string?" data-field-name="AdrQualificationFlag" class="new-driver-field form-select active"><option value="null">Нет</option><option value="Base">Базовая</option><option value="BaseAnd7">Базовая + класс 7</option><option value="BaseAnd1">Базовая + класс 1</option><option value="Full">Полная</option></select></th><td></td><td><select data-field-type="bool" data-field-name="AdrQualificationOfTank" class="new-driver-field form-select active"><option value="true">Да</option><option value="false">Нет</option></select></td><td></td><td></td><td></td><td></td><td></td><td></td></tr>');
   }
      
   function createTruck() {
       truckTable.insertAdjacentHTML('afterbegin', '<tr class="new-truck active"><th scope="row"><input data-field-type="string" data-field-name="Number" class="new-truck-field active" type="text"></th><th scope="row">@Html.Raw("<select data-field-type=\"string\" data-field-name=\"BranchGuid\" class=\"new-truck-field form-select active\" style=\"width: 47ch\">" + stringSelectOfBranches)</th><td></td><td></td><th scope="row"><input data-field-type="string?" data-field-name="PermittedHazardClassesFlags" class="new-truck-field active" type="text" type="text"></th><td></td><td><select data-field-type="bool" data-field-name="TrailerIsTank" class="new-truck-field active"><option value="true">Цистерна</option><option value="false">Тент</option></select></td><th scope="row"><input data-field-type="number" data-field-name="VolumeMax" class="new-truck-field active" type="text"></th><td><input data-field-type="number" data-field-name="VolumePrice" class="new-truck-field active" type="text"></td><td><input data-field-type="number" data-field-name="WeightMax" class="new-truck-field active" type="text"></td><th scope="row"><input data-field-type="number" data-field-name="WeightPrice" class="new-truck-field active" type="text"></th><td><input data-field-type="number" data-field-name="PricePerKm" class="new-truck-field active" type="text"></td><td></td><td></td></tr>');
   }
    
    async function saveChanges() {
        if (driverUpdateRequests.size > 0) {
            let arrayOfDriverUpdateRequests = Array.from(driverUpdateRequests.values());
            for (let driverUpdateRequest of arrayOfDriverUpdateRequests) {
                for (let property in driverUpdateRequest) {
                    switch (property) {
                        case 'SetName':
                            if (isNullOrWhiteSpace(driverUpdateRequest[property])) {
                                alert('Изменения не сохранены: имя водителя не может быть пустым. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'AddHoursWorked':
                            if (isNotNumber(driverUpdateRequest[property])) {
                                alert('Изменения не сохранены: кол-во отработанных часов водителя должно быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                    }
                }
            }
            
            let response = await fetch('https://one290.ru/admin/drivers', {
                credentials: 'same-origin',
                method: 'PATCH',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(arrayOfDriverUpdateRequests)
            });
            if (response.status !== 200)
                alert("При попытке внесения изменений в записи таблицы водителей произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        if (truckUpdateRequests.size > 0) {
            let arrayOfTruckUpdateRequests = Array.from(truckUpdateRequests.values());
            for (let truckUpdateRequest of arrayOfTruckUpdateRequests) {
                for (let property in truckUpdateRequest) {
                    switch (property) {
                        case 'SetNumber':
                            if (isNullOrWhiteSpace(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: номер фуры не может быть пустым. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'SetVolumeMax':
                            if (isNotNumber(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: максимальный объем груза фуры должен быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'SetVolumePrice':
                            if (isNotNumber(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: тариф за объем груза фуры должен быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'SetWeightMax':
                            if (isNotNumber(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: максимальный вес груза фуры должен быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'SetWeightPrice':
                            if (isNotNumber(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: тариф за вес груза фуры должен быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                        case 'SetPricePerKm':
                            if (isNotNumber(truckUpdateRequest[property])) {
                                alert('Изменения не сохранены: ценовой коэффициент фуры должен быть числом. Проверьте ввод и повторите попытку.');
                                return;
                            }
                            break;
                    }
                }
            }
            
            let response = await fetch('https://one290.ru/admin/trucks', {
                credentials: 'same-origin',
                method: 'PATCH',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(arrayOfTruckUpdateRequests)
            });
            if (response.status !== 200)
                alert("При попытке внесения изменений в записи таблицы водителей произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        if (branchUpdateRequests.size > 0) {
            let response = await fetch('https://one290.ru/admin/branches', {
                credentials: 'same-origin',
                method: 'PATCH',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(Array.from(branchUpdateRequests.values()))
            });
            if (response.status !== 200)
                alert("При попытке внесения изменений в записи таблицы филиалов произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        
        if (guidsOfDriversToBeDeleted.size > 0) {
            let guids = 'new[] { ';
            for (let guid of guidsOfDriversToBeDeleted)
                guids += `"${guid}", `;
            guids = guids.slice(0, -2) + ' }';
            
            let response = await fetch(`https://one290.ru/admin/drivers?filter=${guids}.Contains(Guid)`, {
                credentials: 'same-origin',
                method: 'DELETE'
            });
            if (response.status !== 200)
                alert("При попытке удаления записей таблицы водителей произошла ошибка. Изменения не сохранены. Вероятно, в БД имеются заказы, связанные с удаляемыми водителями.");
        }
        
        if (guidsOfTrucksToBeDeleted.size > 0) {
            let guids = 'new[] { ';
            for (let guid of guidsOfTrucksToBeDeleted)
                guids += `"${guid}", `;
            guids = guids.slice(0, -2) + ' }';
            
            let response = await fetch(`https://one290.ru/admin/trucks?filter=${guids}.Contains(Guid)`, {
                credentials: 'same-origin',
                method: 'DELETE'
            });
            if (response.status !== 200)
                alert("При попытке удаления записей таблицы фур произошла ошибка. Изменения не сохранены. Вероятно, в БД имеются заказы, связанные с удаляемыми фурами.");
        }
        
        if (guidsOfBranchesToBeDeleted.size > 0) {
            let guids = 'new[] { ';
            for (let guid of guidsOfBranchesToBeDeleted)
                guids += `"${guid}", `;
            guids = guids.slice(0, -2) + ' }';
            
            let response = await fetch(`https://one290.ru/admin/branches?filter=${guids}.Contains(Guid)`, {
                credentials: 'same-origin',
                method: 'DELETE'
            });
            if (response.status !== 200)
                alert("При попытке удаления записей таблицы филиалов произошла ошибка. Изменения не сохранены. Удалите всех водителей и фур, связанных с удаляемыми филиалами и повторите попытку.");
        }
        
        
        let driverCreateRequests = [];
        let newDrivers = document.getElementsByClassName('new-driver');
        for (let newDriver of newDrivers) {
            let fieldsOfNewDriver = newDriver.getElementsByClassName('new-driver-field');
            let driverCreateRequest = {};
            for (let fieldOfNewDriver of fieldsOfNewDriver) {
                let key = fieldOfNewDriver.dataset.fieldName;
                let value;
                if (fieldOfNewDriver.nodeName === 'SELECT')
                    value = fieldOfNewDriver.options[fieldOfNewDriver.selectedIndex].value;
                else
                    value = fieldOfNewDriver.value;
                if (fieldOfNewDriver.dataset.fieldType === "string?" && value === "null")
                    value = null;
                if (fieldOfNewDriver.dataset.fieldType === "bool")
                    value = value === "true";
                driverCreateRequest[key] = value;
            }
            driverCreateRequests.push(driverCreateRequest);
        }
        if (driverCreateRequests.length > 0) {
            let response = await fetch(`https://one290.ru/admin/drivers`, {
                credentials: 'same-origin',
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(driverCreateRequests)
            });
            if (response.status !== 200)
                alert("При попытке создания записей таблицы водителей произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        let truckCreateRequests = [];
        let newTrucks = document.getElementsByClassName('new-truck');
        for (let newTruck of newTrucks) {
            let fieldsOfNewTruck = newTruck.getElementsByClassName('new-truck-field');
            let truckCreateRequest = {};
            for (let fieldOfNewTruck of fieldsOfNewTruck) {
                let key = fieldOfNewTruck.dataset.fieldName;
                let value;
                if (fieldOfNewTruck.nodeName === 'SELECT')
                    value = fieldOfNewTruck.options[fieldOfNewTruck.selectedIndex].value;
                else
                    value = fieldOfNewTruck.value;
                if (fieldOfNewTruck.dataset.fieldType === "string?" && value === "null")
                    value = null;
                if (fieldOfNewTruck.dataset.fieldType === "bool")
                    value = value === "true";
                if (fieldOfNewTruck.dataset.fieldType === "number")
                    value = Number(value);
                truckCreateRequest[key] = value;
            }
            truckCreateRequests.push(truckCreateRequest);
        }
        if (truckCreateRequests.length > 0) {
            let response = await fetch(`https://one290.ru/admin/trucks`, {
                credentials: 'same-origin',
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(truckCreateRequests)
            });
            if (response.status !== 200)
                alert("При попытке создания записей таблицы фур произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        let branchCreateRequests = [];
        let newBranches = document.getElementsByClassName('new-branch');
        for (let newBranch of newBranches) {
            let fieldsOfNewBranch = newBranch.getElementsByClassName('new-branch-field');
            let branchCreateRequest = {};
            for (let fieldOfNewBranch of fieldsOfNewBranch) {
                let key = fieldOfNewBranch.dataset.fieldName;
                let value = fieldOfNewBranch.value;
                if (fieldOfNewBranch.dataset.fieldType === "number")
                    value = Number(value);
                branchCreateRequest[key] = value;
            }
            branchCreateRequests.push(branchCreateRequest);
        }
        if (branchCreateRequests.length > 0) {
            let response = await fetch(`https://one290.ru/admin/branches`, {
                credentials: 'same-origin',
                method: 'POST',
                headers: {
                  'Accept': 'application/json',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(branchCreateRequests)
            });
            if (response.status !== 200)
                alert("При попытке создания записей таблицы филиалов произошла ошибка. Изменения не сохранены. Проверьте корректность входных данных и повторите попытку.");
        }
        
        
        location.reload();
    }
    </script>
}

<div class="container border border-2 rounded second-border-color p-0">
    <ul class="nav nav-tabs row m-0 p-0 second-background-color first-text-color" role="tablist">
        <li role="presentation" class="nav-item col text-center p-3 border-end first-border-color"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Филиалы</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Водители</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Фуры</button></li>
        <li class="col text-center p-3 border-start first-border-color" style="cursor: pointer" onclick="saveChanges()">Сохранить изменения</li>
    </ul>
    <div class="tab-content row m-0 p-0">
        <div role="tabpanel" class="tab-pane fade show active overflow-auto" id="tab1" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr class="active">
                    <th scope="col">Адрес</th>
                    <th scope="col">Широта</th>
                    <th scope="col">Долгота</th>
                    <th scope="col"><button class="active" type="button" onclick="createBranch()"><i class="fa-solid fa-plus second-text-color"></i></button></th>
                </tr>
                </thead>
                <tbody id="branch-table">
                @Html.Raw(branches.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade overflow-auto" id="tab2" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr class="active">
                    <th scope="col">ФИО</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата приема на работу</th>
                    <th scope="col">Дата увольнения</th>
                    <th scope="col">Квалификация ДОПОГ</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Есть квалификация ДОПОГ на перевозку цистерн</th>
                    <th scope="col">Часов отработано за неделю</th>
                    <th scope="col">Всего часов отработано</th>
                    <th scope="col" colspan="3" class="text-center">Действия</th>
                    <th scope="col"><button class="active" type="button" onclick="createDriver()"><i class="fa-solid fa-plus second-text-color"></i></button></th>
                </tr>
                </thead>
                <tbody id="driver-table">
                @Html.Raw(drivers.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade overflow-auto" id="tab3" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr class="active">
                    <th scope="col">Номер</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата начала эксплуатации</th>
                    <th scope="col">Дата конца эксплуатации</th>
                    <th scope="col">Допустимые классы опасности</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Тип полуприцепа</th>
                    <th scope="col">Максимальный объем груза (м^3)</th>
                    <th scope="col">Цена м^3/км (₽)</th>
                    <th scope="col">Максимальный вес груза (кг)</th>
                    <th scope="col">Цена кг/км (₽)</th>
                    <th scope="col">Ценовой коэффициент (₽)</th>
                    <th scope="col">Действия</th>
                    <th scope="col"><button class="active" type="button" onclick="createTruck()"><i class="fa-solid fa-plus second-text-color"></i></button></th>
                </tr>
                </thead>
                <tbody id="truck-table">
                @Html.Raw(trucks.ToString())
                </tbody>
            </table>
        </div>
    </div>
</div>