@model ICollection<Web.Dtos.Order>

@{
    ViewBag.Title = "Orders";
    Layout = "_FullPageLayout";
}

@section Scripts
{
    <script>
    async function finishOrders() {
        for (let form of document.forms) {
            let actualHoursWorkedByDriver1 = form.elements.actualHoursWorkedByDriver1.value === '' ? null : Number(form.elements.actualHoursWorkedByDriver1.value);
            actualHoursWorkedByDriver1 = isNaN(actualHoursWorkedByDriver1) ? null : actualHoursWorkedByDriver1;
            let actualHoursWorkedByDriver2 = typeof form.elements.actualHoursWorkedByDriver2 === 'undefined' ? null : form.elements.actualHoursWorkedByDriver2.value ;
            actualHoursWorkedByDriver2 = actualHoursWorkedByDriver2 === '' ? null : Number(actualHoursWorkedByDriver2);
            actualHoursWorkedByDriver2 = isNaN(actualHoursWorkedByDriver2) ? null : actualHoursWorkedByDriver2;
        }
    }
    
    document.addEventListener("beforeunload", finishOrders);
    </script>
}

<div class="container border border-2 rounded second-border-color p-0">
    <div class="row m-0 p-0">
        <div class="col overflow-auto" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr class="active">
                    <th scope="col">Статус</th>
                    <th scope="col">Дата создания</th>
                    <th scope="col">Дата назначения исполнителей</th>
                    <th scope="col">Дата оплаты</th>
                    <th scope="col">Дата завершения</th>
                    <th scope="col">Класс опасности</th>
                    <th scope="col">Тип полуприцепа</th>
                    <th scope="col">Длина маршрута (км)</th>
                    <th scope="col">Цена (₽)</th>
                    <th scope="col">Ожидаемое кол-во часов езды фуры</th>
                    <th scope="col">Фактическое кол-во часов вождения фуры первого водителя</th>
                    <th scope="col">Фактическое кол-во часов вождения фуры второго водителя</th>
                    <th scope="col">Кто сделал заказ</th>
                    <th scope="col">Номер фуры-исполнителя</th>
                    <th scope="col">Первый водитель-исполнитель</th>
                    <th scope="col">Второй водитель-исполнитель</th>
                    <th scope="col">Филиал исполнителей</th>
                    <th scope="col">Откуда забрать груз (адрес)</th>
                    <th scope="col">Куда отвезти груз (адрес)</th>
                    <th scope="col">Описание груза</th>
                    <th scope="col">Откуда забрать груз (градусы широты)</th>
                    <th scope="col">Откуда забрать груз (градусы долготы)</th>
                    <th scope="col">Куда отвезти груз (градусы широты)</th>
                    <th scope="col">Куда отвезти груз (градусы долготы)</th>
                    <th scope="col">Объем груза (м^3)</th>
                    <th scope="col">Вес груза (кг)</th>
                    <th scope="col" class="text-center">Действия</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Status</td>
                        <td>@order.DateCreated</td>
                        <td>@order.DateAssignmentOfPerformers</td>
                        <td>@order.DatePaymentAndBegin</td>
                        <td>@order.DateEnd</td>
                        <td>@order.HazardClassFlag</td>
                        <td>@order.TankRequired</td>
                        <td>@order.LengthInKm</td>
                        <td>@order.Price</td>
                        <td>@order.ExpectedHoursWorkedByDrivers</td>
                        <td>@order.ActualHoursWorkedByDriver1</td>
                        <td>@order.ActualHoursWorkedByDriver2</td>
                        <td>@order.UserName</td>
                        <td>@order.TruckNumber</td>
                        <td>@order.Driver1Name</td>
                        <td>@order.Driver2Name</td>
                        <td>@order.BranchAddress</td>
                        <td>@order.StartAddress</td>
                        <td>@order.EndAddress</td>
                        <td>@order.CargoDescription</td>
                        <td>@order.StartPointLatitude</td>
                        <td>@order.StartPointLongitude</td>
                        <td>@order.EndPointLatitude</td>
                        <td>@order.EndPointLongitude</td>
                        <td>@order.CargoVolume</td>
                        <td>@order.CargoWeight</td>
                        <td class="text-center">
                            @if (order.Status == "Ожидает назначения")
                            {
                               <button class="active" type="button" onclick="window.location='https://one290.ru/admin/assignment-of-performers-to-order?orderGuid=@order.Guid';">Назначить исполнителей</button>
                            }
                            else if (order.Status == "Выполняется")
                            {
                                <form>
                                    <input class="active" type="text" placeholder="Часы вождения первого водителя" size="30" name="actualHoursWorkedByDriver1"/>
                                    @if (!string.IsNullOrEmpty(order.Driver2Name))
                                    {
                                        <input class="active" type="text" placeholder="Часы вождения второго водителя" size="30" name="actualHoursWorkedByDriver2"/>
                                    }
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>