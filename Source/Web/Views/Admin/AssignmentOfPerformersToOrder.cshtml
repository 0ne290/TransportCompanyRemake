@using System.Text
@model ICollection<Web.Dtos.Branch>

@{
    ViewBag.Title = "Assignment of performers to order";
    Layout = "_FullPageLayout";
    
    var branchTabs = new StringBuilder(400 * Model.Count);
    var contentOfBranchTabs = new StringBuilder(1);
    var tabCounter = 1;
    @foreach (var branch in Model)
    {
        branchTabs.Append($"<li role=\"presentation\" class=\"nav-item col text-center p-3 border-end first-border-color\"><button class=\"nav-link\" data-bs-toggle=\"tab\" data-bs-target=\"#tab{tabCounter}\" type=\"button\" role=\"tab\">{branch.Address}</button></li>");
        contentOfBranchTabs.Capacity += 1600 * (branch.Drivers.Count + branch.Trucks.Count);
        
        contentOfBranchTabs.Append($"<div role=\"tabpanel\" class=\"tab-pane fade show overflow-auto\" id=\"tab{tabCounter}\" style=\"height: 74vh\"><ul class=\"nav nav-tabs m-0 p-0 second-background-color first-text-color\" role=\"tablist\"><li role=\"presentation\" class=\"nav-item text-center p-3 border-start border-end first-border-color w-50\"><button class=\"nav-link\" data-bs-toggle=\"tab\" data-bs-target=\"#tab{tabCounter}1\" type=\"button\" role=\"tab\">Водители</button></li><li role=\"presentation\" class=\"nav-item text-center p-3 border-start border-end first-border-color w-50\"><button class=\"nav-link\" data-bs-toggle=\"tab\" data-bs-target=\"#tab{tabCounter}2\" type=\"button\" role=\"tab\">Фуры</button></li></ul><div class=\"tab-content row m-0 p-0\"><div role=\"tabpanel\" class=\"tab-pane fade show overflow-auto\" id=\"tab{tabCounter}1\" style=\"height: 74vh\">");
        var drivers = new StringBuilder(1600 * branch.Drivers.Count);
        @foreach (var driver in branch.Drivers)
            drivers.Append($"<tr><th scope=\"row\" class=\"inactive\">{driver.Name}</th><th scope=\"row\" class=\"inactive\">{branch.Address}</th><td class=\"inactive\">{driver.HireDate}</td><td class=\"inactive\">{driver.DismissalDate}</td><th scope=\"row\" class=\"inactive\">{driver.AdrQualificationFlag}</th><td class=\"inactive\">{driver.IsAvailable}</td><td class=\"inactive\">{driver.AdrQualificationOfTank}</td><td class=\"inactive\">{driver.HoursWorkedPerWeek}</td><td class=\"inactive\">{driver.TotalHoursWorked}</td></tr>");
        
        contentOfBranchTabs.Append($"<table class=\"table my-table m-0 p-0\"><thead class=\"sticky-top\"><tr class=\"active\"><th scope=\"col\">ФИО</th><th scope=\"col\">Филиал</th><th scope=\"col\">Дата приема на работу</th><th scope=\"col\">Дата увольнения</th><th scope=\"col\">Квалификация ДОПОГ</th><th scope=\"col\">Готов к выполнению заказа</th><th scope=\"col\">Есть квалификация ДОПОГ на перевозку цистерн</th><th scope=\"col\">Часов отработано за неделю</th><th scope=\"col\">Всего часов отработано</th></tr></thead><tbody>{drivers.ToString()}</tbody></table></div><div role=\"tabpanel\" class=\"tab-pane fade show overflow-auto\" id=\"tab{tabCounter}2\" style=\"height: 74vh\">");
        var trucks = new StringBuilder(1600 * branch.Trucks.Count);
        @foreach (var truck in branch.Trucks)
            trucks.Append($"<tr><th scope=\"row\" class=\"inactive\">{truck.Number}</th><th scope=\"row\" class=\"inactive\">{branch.Address}</th><td class=\"inactive\">{truck.CommissionedDate}</td><td class=\"inactive\">{truck.DecommissionedDate}</td><th scope=\"row\" class=\"inactive\">{truck.PermittedHazardClassesFlags}</th><td class=\"inactive\">{truck.IsAvailable}</td><td class=\"inactive\">{truck.TrailerIsTank}</td><th scope=\"row\" class=\"inactive\">{truck.VolumeMax}</th><td class=\"inactive\">{truck.VolumePrice}</td><td class=\"inactive\">{truck.WeightMax}</td><th scope=\"row\" class=\"inactive\">{truck.WeightPrice}</th><td>{truck.PricePerKm}</td></tr>");
        contentOfBranchTabs.Append($"<table class=\"table my-table m-0 p-0\"><thead class=\"sticky-top\"><tr class=\"active\"><th scope=\"col\">Номер</th><th scope=\"col\">Филиал</th><th scope=\"col\">Дата начала эксплуатации</th><th scope=\"col\">Дата конца эксплуатации</th><th scope=\"col\">Допустимые классы опасности</th><th scope=\"col\">Готов к выполнению заказа</th><th scope=\"col\">Тип полуприцепа</th><th scope=\"col\">Максимальный объем груза (м^3)</th><th scope=\"col\">Цена м^3/км (\u20bd)</th><th scope=\"col\">Максимальный вес груза (кг)</th><th scope=\"col\">Цена кг/км (\u20bd)</th><th scope=\"col\">Ценовой коэффициент (\u20bd)</th></tr></thead><tbody id=\"truck-table\">{trucks.ToString()}</tbody></table></div></div></div>");
        
        tabCounter++;
    }
}

<div class="container border border-2 rounded second-border-color p-0">
    <ul class="nav nav-tabs row m-0 p-0 second-background-color first-text-color" role="tablist">
        @Html.Raw(branchTabs.ToString())
    </ul>
    <div class="tab-content row m-0 p-0">
        @Html.Raw(contentOfBranchTabs.ToString())
    </div>
</div>