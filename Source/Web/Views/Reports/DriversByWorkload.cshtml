@using System.Globalization
@model ICollection<Application.Dtos.Driver.ByWorkload>

@{
    ViewBag.Title = "Drivers by profit";
    Layout = "_ReportPageLayout";
}

<div class="w-100">
    <table class="w-100 m-0 p-0 report-table">
        <thead>
        <tr>
            <th scope="col">ФИО</th>
            <th scope="col">Кол-во заказов</th>
            <th scope="col">Часы работы</th>
        </tr>
        </thead>
    <tbody>
    @foreach (var driverByWorkload in Model)
    {
        <tr>
            <td>@driverByWorkload.DriverName</td>
            <td>@driverByWorkload.OrderCount</td>
            <td>@driverByWorkload.HoursWorked.ToString("F6", CultureInfo.InvariantCulture)</td>
        </tr>
    }
    </tbody>
    </table>
</div>