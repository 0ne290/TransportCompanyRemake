@{
    ViewBag.Title = "Reports";
    Layout = "_FullPageLayout";
}

<div class="container border border-2 rounded second-border-color p-0 w-25">
    <div class="row m-0 p-0">
        <div class="col12 py-3 border-bottom text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/clients-by-profit';" style="cursor: pointer">Клиенты по прибыли</div>
        <div class="col12 py-3 border-bottom border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/drivers-by-profit';" style="cursor: pointer">Водители по прибыли</div>
        <div class="col12 py-3 border-bottom border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/drivers-by-weekly-workload';" style="cursor: pointer">Нагрузка водителей за эту неделю</div>
        <div class="col12 py-3 border-bottom border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/drivers-by-total-workload';" style="cursor: pointer">Нагрузка водителей всего</div>
        <div class="col12 py-3 border-bottom border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/drivers-by-efficiency';" style="cursor: pointer">Водители по соотношению "час вождения / прибыль"</div>
        <div class="col12 py-3 border-bottom border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/trucks-by-route-traveled';" style="cursor: pointer">Фуры по пройденному пути</div>
        <div class="col12 py-3 border-top text-center second-background-color first-text-color first-border-color" onclick="window.location = 'https://one290.ru/reports/trucks-by-efficiency';" style="cursor: pointer">Фуры по соотношению "км пути / прибыль"</div>
    </div>
</div>