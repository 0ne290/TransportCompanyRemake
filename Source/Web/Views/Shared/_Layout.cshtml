<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <script src="~/dist/site.entry.js" defer></script>
  @await RenderSectionAsync("Scripts", false)
  <link rel="stylesheet" href="~/dist/site.css">
</head>

<body class="first-font">
<header class="header second-background-color first-text-color">
  <div class="container-fluid h-100">
    <div class="row h-100">
      <div class="col d-flex justify-content-center align-items-center h-100 border-end first-border-color"><h2>Заказы</h2></div>
      <div class="col d-flex justify-content-center align-items-center h-100 border-start first-border-color"><h2>Администрирование</h2></div>
    </div>
  </div>
</header>
<main class="main first-background-color second-text-color">
  @RenderBody()
</main>
</body>

</html>