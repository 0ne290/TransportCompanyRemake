<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <script src="https://unpkg.com/@@vkid/sdk@2.1.0/dist-sdk/umd/index.js"></script>
  <script src="~/dist/site.entry.js" defer></script>
  @await RenderSectionAsync("ImportScripts", false)
  <link rel="stylesheet" href="~/dist/site.css">
</head>

<body class="first-font">
<header class="header second-background-color first-text-color">
  <div class="container-fluid h-100">
    <div class="row h-100">
      <div class="col d-flex justify-content-center align-items-center h-100 border-end first-border-color" style="cursor: pointer"><h2>Заказы</h2></div>
      <div class="col d-flex justify-content-center align-items-center h-100 border-start border-end first-border-color" style="cursor: pointer"><h2>Администрирование</h2></div>
      <div class="col-2 d-flex justify-content-center align-items-center h-100 border-start first-border-color" style="cursor: pointer" onclick="window.location='https://one290.ru/user/auth';"><h2>Вход</h2></div>
    </div>
  </div>
</header>
<main class="main first-background-color second-text-color">
  @RenderBody()
</main>
@await RenderSectionAsync("Scripts", false)
</body>
</html>