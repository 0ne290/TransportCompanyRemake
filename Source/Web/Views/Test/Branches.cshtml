@using System.Text

@model ICollection<Web.ViewModels.Branch>

@{
    ViewBag.Title = "Branches";
    Layout = "_Layout";
    
    var branches = new StringBuilder(400 * Model.Count);
    var drivers = new StringBuilder(1);
    var trucks = new StringBuilder(1);
    @foreach (var branch in Model)
    {
        branches.Append($"<tr><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{branch.Address}\"></th><td><input class=\"unmodified-input\" type=\"text\" value=\"{branch.Latitude}\"></td><td><input class=\"modified-input\" type=\"text\" value=\"{branch.Longitude}\"></td></tr>");
        
        drivers.Capacity += 1200 * branch.Drivers.Count;
        @foreach (var driver in branch.Drivers)
            drivers.Append($"<tr><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{driver.Name}\"></th><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{branch.Address}\"></th><td>{driver.HireDate}</td><td>{driver.DismissalDate}</td><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{driver.AdrQualificationFlag}\"></th><td><input class=\"unmodified-input\" type=\"text\" value=\"{driver.IsAvailable}\"></td><td><input class=\"modified-input\" type=\"text\" value=\"{driver.AdrQualificationOfTank}\"></td><td>{driver.HoursWorkedPerWeek}</td><td>{driver.TotalHoursWorked}</td><td><button class=\"second-background-color first-text-color\" type=\"button\" value=\"{driver.ButtonValue}\">{driver.ButtonText}</button></td><td><input class=\"modified-input\" type=\"text\" placeholder=\"Добавить отработанных часов\"></td><td><button class=\"second-background-color first-text-color\" type=\"button\" value=\"ResetHoursWorkedPerWeek\">Сбросить часы, отработанные за неделю</button></td></tr>");
		
        trucks.Capacity += 1200 * branch.Trucks.Count;
        @foreach (var truck in branch.Trucks)
            trucks.Append($"<tr><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{truck.Number}\"></th><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{branch.Address}\"></th><td>{truck.CommissionedDate}</td><td>{truck.DecommissionedDate}</td><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{truck.PermittedHazardClassesFlags}\"></th><td><input class=\"unmodified-input\" type=\"text\" value=\"{truck.IsAvailable}\"></td><td><input class=\"modified-input\" type=\"text\" value=\"{truck.TrailerIsTank}\"></td><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{truck.VolumeMax}\"></th><td><input class=\"unmodified-input\" type=\"text\" value=\"{truck.VolumePrice}\"></td><td><input class=\"modified-input\" type=\"text\" value=\"{truck.WeightMax}\"></td><th scope=\"row\"><input class=\"unmodified-input\" type=\"text\" value=\"{truck.WeightPrice}\"></th><td><input class=\"unmodified-input\" type=\"text\" value=\"{truck.PricePerKm}\"></td><td><button class=\"second-background-color first-text-color\" type=\"button\" value=\"{truck.ButtonValue}\">{truck.ButtonText}</button></td></tr>");
    }
}

<div class="container border border-2 rounded second-border-color p-0">
    <ul class="nav nav-tabs row m-0 p-0 second-background-color first-text-color" role="tablist">
        <li role="presentation" class="nav-item col text-center p-3 border-end first-border-color"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Филиалы</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Водители</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Фуры</button></li>
        <li class="col text-center p-3 border-start first-border-color">Сохранить изменения</li>
    </ul>
    <div class="tab-content row m-0 p-0 overflow-x-scroll">
        <div role="tabpanel" class="tab-pane fade show active" id="tab1">
            <table class="table my-table m-0 p-0">
                <thead>
                <tr>
                    <th scope="col">Адрес</th>
                    <th scope="col">Широта</th>
                    <th scope="col">Долгота</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(branches.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade" id="tab2">
            <table class="table my-table m-0 p-0">
                <thead>
                <tr>
                    <th scope="col">ФИО</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата приема на работу</th>
                    <th scope="col">Дата увольнения</th>
                    <th scope="col">Квалификация ДОПОГ</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Есть квалификация ДОПОГ на перевозку цистерн</th>
                    <th scope="col">Часов отработано за неделю</th>
                    <th scope="col">Всего часов отработано</th>
                    <th scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(drivers.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade" id="tab3">
            <table class="table my-table m-0 p-0">
                <thead>
                <tr>
                    <th scope="col">Номер</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата начала эксплуатации</th>
                    <th scope="col">Дата конца эксплуатации</th>
                    <th scope="col">Допустимые классы опасности</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Тип полуприцепа</th>
                    <th scope="col">Максимальный объем груза (м^3)</th>
                    <th scope="col">Цена м^3/км (₽)</th>
                    <th scope="col">Максимальный вес груза (кг)</th>
                    <th scope="col">Цена кг/км (₽)</th>
                    <th scope="col">Ценовой коэффициент (₽)</th>
                    <th scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(trucks.ToString())
                </tbody>
            </table>
        </div>
    </div>
</div>