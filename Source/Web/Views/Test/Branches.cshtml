@{
    ViewBag.Title = "Branches";
    Layout = "_Layout";
}

@model IEnumerable<Application.Dtos.Branch.Response>

<div class="container border-top rounded-top border-bottom rounded-bottom first-border-color overflow-hidden">
    <div class="row second-background-color first-text-color">
        <div class="col text-center p-3 border-end first-border-color">Филиалы</div>
        <div class="col text-center p-3 border-start border-end first-border-color">Водители</div>
        <div class="col text-center p-3 border-start border-end first-border-color">Фуры</div>
        <div class="col text-center p-3 border-start first-border-color">Сохранить изменения</div>
    </div>
    <table class="table">
        <thead>
        <tr>
            <th scope="col">Адрес</th>
            <th scope="col">Широта</th>
            <th scope="col">Долгота</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var branch in Model)
        {
            <tr>
                <th scope="row"><input type="text" value="@branch.Address"></th>
                <td><input type="text" value="@branch.Latitude"></td>
                <td><input type="text" value="@branch.Longitude"></td>
            </tr>
        }
        </tbody>
    </table>
</div>