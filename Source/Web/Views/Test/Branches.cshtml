@using System.Text

@model ICollection<Web.ViewModels.Branch>

@{
    ViewBag.Title = "Branches";
    Layout = "_Layout";
    
    var branches = new StringBuilder(400 * Model.Count);
    var selectOfBranches = new StringBuilder(150 * Model.Count);
    @foreach (var branch in Model)
    {
        branches.Append($"<tr><th scope=\"row\"><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Address}\" oninput=\"setBranchAddress(this)\"></th><td><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Latitude}\" oninput=\"setBranchLatitude(this)\"></td><td><input data-branch-guid=\"{branch.Guid}\" class=\"inactive\" type=\"text\" value=\"{branch.Longitude}\" oninput=\"setBranchLongitude(this)\"></td></tr>");
        selectOfBranches.Append($"<option value=\"{branch.Guid}\">{branch.Address}</option>");
    }
    selectOfBranches.Append("</select>");
    
    var drivers = new StringBuilder(1);
    var trucks = new StringBuilder(1);
    @foreach (var branch in Model)
    {
        drivers.Capacity += 1600 * branch.Drivers.Count;
        @foreach (var driver in branch.Drivers)
        {
            selectOfBranches.Replace($"<option value=\"{branch.Guid}\">{branch.Address}</option>", $"<option selected value=\"{branch.Guid}\">{branch.Address}</option>");
            drivers.Append($"<tr><th scope=\"row\"><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" value=\"{driver.Name}\" oninput=\"setDriverName(this)\"></th><th scope=\"row\">{$"<select data-driver-guid=\"{driver.Guid}\" class=\"form-select inactive\" onchange=\"setDriverBranch(this)\">" + selectOfBranches.ToString().Replace($"<option value=\"{branch.Guid}\">{branch.Address}</option>", $"<option selected value=\"{branch.Guid}\">{branch.Address}</option>")}</th><td>{driver.HireDate}</td><td>{driver.DismissalDate}</td><th scope=\"row\"><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" value=\"{driver.AdrQualificationFlag}\" oninput=\"setDriverAdrQualificationFlag(this)\"></th><td><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" value=\"{driver.IsAvailable}\" oninput=\"setDriverIsAvailable(this)\"></td><td><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" value=\"{driver.AdrQualificationOfTank}\" oninput=\"setDriverAdrQualificationOfTank(this)\"></td><td>{driver.HoursWorkedPerWeek}</td><td>{driver.TotalHoursWorked}</td><td><button data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"button\" value=\"{driver.ButtonValue}\" onclick=\"dismissOrReinstateDriver(this)\">{driver.ButtonText}</button></td><td><input data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"text\" size=\"27\" placeholder=\"Добавить отработанных часов\" oninput=\"addDriverHoursWorked(this)\"></td><td><button data-driver-guid=\"{driver.Guid}\" class=\"inactive\" type=\"button\" value=\"ResetHoursWorkedPerWeek\" onclick=\"resetDriverHoursWorkedPerWeek(this)\">Сбросить часы, отработанные за неделю</button></td></tr>");
            selectOfBranches.Replace($"<option selected value=\"{branch.Guid}\">{branch.Address}</option>", $"<option value=\"{branch.Guid}\">{branch.Address}</option>");
        }
		
        trucks.Capacity += 1600 * branch.Trucks.Count;
        @foreach (var truck in branch.Trucks)
            trucks.Append($"<tr><th scope=\"row\"><input class=\"inactive\" type=\"text\" value=\"{truck.Number}\"></th><th scope=\"row\"><input class=\"inactive\" type=\"text\" value=\"{branch.Address}\"></th><td>{truck.CommissionedDate}</td><td>{truck.DecommissionedDate}</td><th scope=\"row\"><input class=\"inactive\" type=\"text\" value=\"{truck.PermittedHazardClassesFlags}\"></th><td><input class=\"inactive\" type=\"text\" value=\"{truck.IsAvailable}\"></td><td><input class=\"inactive\" type=\"text\" value=\"{truck.TrailerIsTank}\"></td><th scope=\"row\"><input class=\"inactive\" type=\"text\" value=\"{truck.VolumeMax}\"></th><td><input class=\"inactive\" type=\"text\" value=\"{truck.VolumePrice}\"></td><td><input class=\"inactive\" type=\"text\" value=\"{truck.WeightMax}\"></td><th scope=\"row\"><input class=\"inactive\" type=\"text\" value=\"{truck.WeightPrice}\"></th><td><input class=\"inactive\" type=\"text\" value=\"{truck.PricePerKm}\"></td><td><button class=\"second-background-color first-text-color\" type=\"button\" value=\"{truck.ButtonValue}\">{truck.ButtonText}</button></td></tr>");
    }
    selectOfBranches.Append("</select>");
    
}

@section Scripts
{
    <script>
    let branchUpdateRequests = new Map();
    let driverUpdateRequests = new Map();
    
    function setBranchAddress(input) {
        let branchGuid = input.dataset.branchGuid;
        let newAddress = input.value;
        
        if (branchUpdateRequests.has(branchGuid)) {
            let branchUpdateRequest = branchUpdateRequests.get(branchGuid);
            branchUpdateRequest.SetAddress = newAddress;
        }
        else
            branchUpdateRequests.set(branchGuid, { Guid: branchGuid, SetAddress: newAddress });
        
        input.classList.replace('inactive', 'active')
    }
    
    function setBranchLatitude(input) {
        let branchGuid = input.dataset.branchGuid;
        let newLatitude = input.value;
        
        if (branchUpdateRequests.has(branchGuid)) {
            let branchUpdateRequest = branchUpdateRequests.get(branchGuid);
            branchUpdateRequest.SetLatitude = newLatitude;
        }
        else
            branchUpdateRequests.set(branchGuid, { Guid: branchGuid, SetLatitude: newLatitude });
        
        input.classList.replace('inactive', 'active')
    }
    
    function setBranchLongitude(input) {
        let branchGuid = input.dataset.branchGuid;
        let newLongitude = input.value;
        
        if (branchUpdateRequests.has(branchGuid)) {
            let branchUpdateRequest = branchUpdateRequests.get(branchGuid);
            branchUpdateRequest.SetLongitude = newLongitude;
        }
        else
            branchUpdateRequests.set(branchGuid, { Guid: branchGuid, SetLongitude: newLongitude });
        
        input.classList.replace('inactive', 'active')
    }
    
    function setDriverName(input) {
        let driverGuid = input.dataset.driverGuid;
        let newName = input.value;
        
        if (driverUpdateRequests.has(driverGuid)) {
            let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
            driverUpdateRequest.SetName = newName;
        }
        else
            driverUpdateRequests.set(driverGuid, { Guid: driverGuid, SetName: newName });
        
        input.classList.replace('inactive', 'active')
    }
    
    function setDriverBranch(select) {
       let driverGuid = select.dataset.driverGuid;
       let newBranch = select.options[select.selectedIndex].value;
       
       if (driverUpdateRequests.has(driverGuid)) {
           let driverUpdateRequest = driverUpdateRequests.get(driverGuid);
           driverUpdateRequest.SetBranch = newBranch;
       }
       else
           driverUpdateRequests.set(driverGuid, { Guid: driverGuid, SetBranch: newBranch });
       
       select.classList.replace('inactive', 'active')
   }
    
    async function saveChanges() {
        let response1 = await fetch('http://192.168.0.103/test/branches', {
            method: 'PATCH',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(Array.from(branchUpdateRequests.values()))
        });
        let response2 = await fetch('http://192.168.0.103/test/drivers', {
            method: 'PATCH',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(Array.from(driverUpdateRequests.values()))
        });
        alert(response1.status);
        alert(response2.status);
        location.reload();
    }
    </script>
}

<div class="container border border-2 rounded second-border-color p-0">
    <ul class="nav nav-tabs row m-0 p-0 second-background-color first-text-color" role="tablist">
        <li role="presentation" class="nav-item col text-center p-3 border-end first-border-color"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab1" type="button" role="tab">Филиалы</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab2" type="button" role="tab">Водители</button></li>
        <li role="presentation" class="nav-item col text-center p-3 border-start border-end first-border-color"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab3" type="button" role="tab">Фуры</button></li>
        <li class="col text-center p-3 border-start first-border-color" style="cursor: pointer" onclick="saveChanges()">Сохранить изменения</li>
    </ul>
    <div class="tab-content row m-0 p-0">
        <div role="tabpanel" class="tab-pane fade show active overflow-auto" id="tab1" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr>
                    <th scope="col">Адрес</th>
                    <th scope="col">Широта</th>
                    <th scope="col">Долгота</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(branches.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade overflow-auto" id="tab2" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr>
                    <th scope="col">ФИО</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата приема на работу</th>
                    <th scope="col">Дата увольнения</th>
                    <th scope="col">Квалификация ДОПОГ</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Есть квалификация ДОПОГ на перевозку цистерн</th>
                    <th scope="col">Часов отработано за неделю</th>
                    <th scope="col">Всего часов отработано</th>
                    <th scope="col" colspan="3" class="text-center">Действия</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(drivers.ToString())
                </tbody>
            </table>
        </div>
        <div role="tabpanel" class="tab-pane fade overflow-auto" id="tab3" style="height: 74vh">
            <table class="table my-table m-0 p-0">
                <thead class="sticky-top">
                <tr>
                    <th scope="col">Номер</th>
                    <th scope="col">Филиал</th>
                    <th scope="col">Дата начала эксплуатации</th>
                    <th scope="col">Дата конца эксплуатации</th>
                    <th scope="col">Допустимые классы опасности</th>
                    <th scope="col">Готов к выполнению заказа</th>
                    <th scope="col">Тип полуприцепа</th>
                    <th scope="col">Максимальный объем груза (м^3)</th>
                    <th scope="col">Цена м^3/км (₽)</th>
                    <th scope="col">Максимальный вес груза (кг)</th>
                    <th scope="col">Цена кг/км (₽)</th>
                    <th scope="col">Ценовой коэффициент (₽)</th>
                    <th scope="col">Действия</th>
                </tr>
                </thead>
                <tbody>
                @Html.Raw(trucks.ToString())
                </tbody>
            </table>
        </div>
    </div>
</div>