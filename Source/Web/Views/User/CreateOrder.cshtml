@{
    ViewBag.Title = "Create order";
    Layout = "_FullPageLayout";
}

@section Scripts
{
    <script>
    async function createOrder() {
        let elementsOfOrderCreationForm = document.forms['create-order'].elements;
        
        let selectOfTankRequired = elementsOfOrderCreationForm['tank-required'];
        let valueofSelectedOptionOfSelectOfTankRequired = selectOfTankRequired.options[selectOfTankRequired.selectedIndex].value;
        let tankRequired = 'Invalid value';
        if (valueofSelectedOptionOfSelectOfTankRequired === 'true')
            tankRequired = true;
        else if (valueofSelectedOptionOfSelectOfTankRequired === 'false')
            tankRequired = false;
        
        let selectOfHazardClassFlag = elementsOfOrderCreationForm['hazard-class-flag'];
        let hazardClassFlag = selectOfHazardClassFlag.options[selectOfHazardClassFlag.selectedIndex].value;
        if (hazardClassFlag === 'null')
            hazardClassFlag = null;
        
        let requestToCreateOrder = {
            StartAddress: elementsOfOrderCreationForm['start-address'].value,
            EndAddress: elementsOfOrderCreationForm['end-address'].value,
            CargoDescription: elementsOfOrderCreationForm['cargo-description'].value,
            StartPointLatitude: Number(elementsOfOrderCreationForm['start-point-latitude'].value),
            StartPointLongitude: Number(elementsOfOrderCreationForm['start-point-longitude'].value),
            EndPointLatitude: Number(elementsOfOrderCreationForm['end-point-latitude'].value),
            EndPointLongitude: Number(elementsOfOrderCreationForm['end-point-longitude'].value),
            CargoVolume: Number(elementsOfOrderCreationForm['cargo-volume'].value),
            CargoWeight: Number(elementsOfOrderCreationForm['cargo-weight'].value),
            TankRequired: tankRequired,
            HazardClassFlag: hazardClassFlag
        };
        
        let response = await fetch('https://one290.ru/user/create-order', {
            credentials: 'same-origin',
            method: 'POST',
            headers: {
              'Accept': 'application/json',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(requestToCreateOrder)
        });
        if (response.status === 200)
            alert('Заказ успешно создан. С Вами может связаться наш диспетчер, если ему потребуется уточнить детали заказа. После того, как диспетчер назначит исполнителей на заказ, Вы должны будете его оплатить (доступна онлайн-оплата на сайте - на странице Ваших заказов появится кнопка "Оплатить" в строке этого заказа). После оплаты заказ перейдет в стадию "Исполнение". Вы сможете отслеживать статус заказа на странице заказов. После доставки груза в место назначения с Вами свяжется диспетчер для подтверждения факта получения груза. Если Вы подтвердите, заказ перейдет в стадию "Завершен". В любое время и на любом этапе Вы можете связаться с диспетчером и обсудить любые детали. Благодарим Вас за выбор нашей компании.');
        else
            alert("Не удалось создать заказ. Вероятно, какое-то поле пустое и/или Вы не выбрали тип полуприцепа и/или класс опасности груза. Проверьте корректность данных в форме и повторите попытку.");
    }
    </script>
}

<div class="container border border-2 rounded second-border-color p-0 w-25">
    <div class="row m-0 p-0">
        <div class="col">
            <form name="create-order">
                <input class="w-100 active mt-3 mb-2" type="text" placeholder="Откуда забрать груз (адрес)" name="start-address">
                <input class="w-100 active mb-2" type="text" placeholder="Куда отвезти груз (адрес)" name="end-address">
                <input class="w-100 active mb-2" type="text" placeholder="Описание груза" name="cargo-description">
                <input class="w-100 active mb-2" type="text" placeholder="Откуда забрать груз (градусы широты)" name="start-point-latitude">
                <input class="w-100 active mb-2" type="text" placeholder="Откуда забрать груз (градусы долготы)" name="start-point-longitude">
                <input class="w-100 active mb-2" type="text" placeholder="Куда отвезти груз (градусы широты)" name="end-point-latitude">
                <input class="w-100 active mb-2" type="text" placeholder="Куда отвезти груз (градусы долготы)" name="end-point-longitude">
                <input class="w-100 active mb-2" type="text" placeholder="Объем груза (кубометры)" name="cargo-volume">
                <input class="w-100 active mb-2" type="text" placeholder="Вес груза (килограммы)" name="cargo-weight">
                <select class="w-100 active mb-2" name="tank-required">
                    <option selected value="Invalid value">В каком полуприцепе перевозить</option>
                    <option value="true">Цистерна</option>
                    <option value="false">Тент</option>
                </select>
                <select class="w-100 active mb-2" name="hazard-class-flag">
                    <option selected value="Invalid value">Класс опасности груза</option>
                    <option value="null">Нет</option>
                    <option value="11">1.1</option>
                    <option value="12">1.2</option>
                    <option value="13">1.3</option>
                    <option value="14">1.4</option>
                    <option value="15">1.5</option>
                    <option value="16">1.6</option>
                    <option value="21">2.1</option>
                    <option value="22">2.2</option>
                    <option value="23">2.3</option>
                    <option value="3">3</option>
                    <option value="41">4.1</option>
                    <option value="42">4.2</option>
                    <option value="43">4.3</option>
                    <option value="51">5.1</option>
                    <option value="52">5.2</option>
                    <option value="61">6.1</option>
                    <option value="62">6.2</option>
                    <option value="7">7</option>
                    <option value="8">8</option>
                    <option value="9">9</option>
                </select>
            </form>
            <button class="w-100 active mb-3" type="button" onclick="createOrder()">Сделать заказ</button>
        </div>
    </div>
</div>