@{
    Layout = "_ScriptPageLayout";
}

@section ImportScripts
{
    <script src="https://unpkg.com/@@vkid/sdk@2.1.0/dist-sdk/umd/index.js"></script>
}

<script>
const urlParams = new URLSearchParams(window.location.search);

const code = urlParams.get('code');
const deviceId = urlParams.get('device_id');


const VKID = window.VKIDSDK;
      
VKID.Config.init({
  app: 52175387,
  redirectUrl: 'https://one290.ru/user/vk-login',
  state: generateCodeVerifier(64),
  codeVerifier: generateCodeVerifier(64),
  scope: 'vkid.personal_info',
  mode: VKID.ConfigAuthMode.InNewTab
});

const vkAuthMessage = VKID.Auth.exchangeCode(code, deviceId);
const accessToken = vkAuthMessage.access_token;
const vkUserInfo = VKID.Auth.userInfo(accessToken);
const userCreateRequest = { };
userCreateRequest.Name = vkUserInfo.user.first_name + ' ' + vkUserInfo.user.last_name;
userCreateRequest.Contact = vkUserInfo.user.phone;
userCreateRequest.VkUserId = vkUserInfo.user.user_id;

let response = await fetch(`https://one290.ru/user/vk-login`, {
    method: 'POST',
    headers: {
      'Accept': 'application/json',
      'Content-Type': 'application/json'
    },
    body: JSON.stringify(userCreateRequest)
});
if (response.status === 200)
    window.location='https://one290.ru/user/orders';
else
    alert('Баг: аутентификация через ВК не удалась.')
</script>